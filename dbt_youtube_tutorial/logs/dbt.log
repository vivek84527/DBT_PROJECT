[0m19:35:29.805982 [debug] [Thread-7 (]: On model.dbt_youtube_tutorial.silver_salesonfo: /* {"app": "dbt", "dbt_version": "1.11.11", "dbt_databricks_version": "1.10.9", "databricks_sql_connector_version": "4.2.6", "profile_name": "dbt_youtube_tutorial", "target_name": "dev", "node_id": "model.dbt_youtube_tutorial.silver_salesonfo"} */

  
    
        create or replace table `dbt_tutorial_dev`.`silver`.`silver_salesonfo`
      
      
  using delta
      
      
      
      
      
      
      
      as
      with sales as (
    select 
        sales_id,
         product_sk,
        customer_sk,
        
  quantity * unit_price
 as calculated_gross_amount,
           gross_amount,
           payment_method
    from `dbt_tutorial_dev`.`bronze`.`bronze_sales`
),
bronze_products as (
    select 
    product_sk,
    category
    from `dbt_tutorial_dev`.`bronze`.`bronze_product`
),

customer as (
    select 
    customer_sk,
    gender
    from `dbt_tutorial_dev`.`bronze`.`bronze_customer`
),
joined_query as (
select 
    sales.sales_id,
    sales.gross_amount, 
    sales.payment_method,
    bronze_products.category,
    customer.gender
from sales join bronze_products on sales.product_sk = bronze_products.product_sk
join customer on sales.customer_sk = customer.customer_sk    
)

select
    category,
    gender,
    sum(gross_amount) as total_sales_amount

from joined_query 
group by category, gender
order by total_sales_amount desc
  
